{
  "name": "manage.rt.gtfs.zone",
  "version": "0.0.0-development",
  "description": "Map-first manager for gtfs.zone feeds, trackers and assignments",
  "main": "src/index.html",
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "vendor:check": "tsx scripts/vendor-check.ts",
    "check-rt-spec": "tsx scripts/check-rt-spec.ts",
    "check-alert-enums": "tsx scripts/check-alert-enums.ts",
    "check": "pnpm run typecheck && pnpm run check-rt-spec && pnpm run check-alert-enums"
  },
  "keywords": [
    "gtfs",
    "transit",
    "realtime",
    "admin"
  ],
  "author": "gtfs.zone contributors",
  "license": "AGPL-3.0",
  "devDependencies": {
    "@types/geojson": "^7946.0.16",
    "@types/node": "^24.19.0",
    "@types/papaparse": "^5.5.2",
    "autoprefixer": "^10.6.1",
    "gtfs-realtime-bindings": "^2.2.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^7.3.6"
  },
  "dependencies": {
    "@leeoniya/ufuzzy": "^1.0.19",
    "@tailwindcss/postcss": "^4.3.3",
    "daisyui": "^5.7.46",
    "interlocking": "github:gtfs-zone/interlocking#v4.0.0",
    "jszip": "^3.10.2",
    "maplibre-gl": "^6.11.2",
    "papaparse": "^5.7.0"
  }
}
