{
  "name": "gtfs-zone-rt-manager",
  "version": "0.0.0-development",
  "description": "Map-first manager for gtfs.zone feeds, trackers and assignments",
  "main": "src/index.html",
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "check-rt-spec": "tsx scripts/check-rt-spec.ts",
    "check-alert-enums": "tsx scripts/check-alert-enums.ts",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run knip && pnpm run check-rt-spec && pnpm run check-alert-enums",
    "lint": "eslint src/ scripts/ vite.config.ts --max-warnings 0",
    "lint:fix": "eslint src/ scripts/ vite.config.ts --fix",
    "format": "prettier --write src/ scripts/ vite.config.ts",
    "knip": "knip",
    "vuln": "sh scripts/vuln-gate.sh",
    "commit": "cz commit"
  },
  "keywords": [
    "gtfs",
    "transit",
    "realtime",
    "admin"
  ],
  "author": "gtfs.zone contributors",
  "license": "AGPL-3.0-or-later",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^24.19.0",
    "@types/papaparse": "^5.5.2",
    "autoprefixer": "^10.6.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "gtfs-realtime-bindings": "^2.2.0",
    "knip": "^6.39.0",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^7.3.6"
  },
  "dependencies": {
    "@leeoniya/ufuzzy": "^1.0.19",
    "@tailwindcss/postcss": "^4.3.3",
    "daisyui": "^5.7.46",
    "gtfs-zone-web-common": "github:gtfs-zone/gtfs-zone-web-common#v5.11.0",
    "jszip": "^3.10.2",
    "maplibre-gl": "^6.11.2",
    "papaparse": "^5.7.0"
  }
}
